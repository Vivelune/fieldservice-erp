generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------
// ENUMS
// -----------------------------------------------------

enum MembershipRole {
  OWNER
  TECHNICIAN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum LineItemType {
  MATERIAL
  LABOR
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// -----------------------------------------------------
// TENANT
// A tenant represents a company using the ERP.
// -----------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships  Membership[]
  invitations  Invitation[]
  customers    Customer[]
  jobs         Job[]
  invoices     Invoice[]
  payments     Payment[]
  stripeEvents StripeEvent[]
  outboxEvents OutboxEvent[]

  @@map("tenants")
}

// -----------------------------------------------------
// USER
// Global identity shared across tenant memberships.
// Better Auth integration will be added separately.
// -----------------------------------------------------

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(150)
  email         String   @unique @db.VarChar(255)
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}



model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address") @db.VarChar(100)
  userAgent String?  @map("user_agent") @db.Text
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(100)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

// -----------------------------------------------------
// MEMBERSHIP
// Connects a user to a tenant.
// -----------------------------------------------------

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole @default(TECHNICIAN)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedJobs Job[] @relation("JobAssignee")
  invitations  Invitation[] @relation("InvitationInviter")

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@map("memberships")
}

// -----------------------------------------------------
// INVITATION
// Invitations are scoped to a tenant.
// Store only hashed invitation tokens.
// -----------------------------------------------------

model Invitation {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  invitedByMembershipId String           @map("invited_by_membership_id") @db.Uuid
  email                 String           @db.VarChar(255)
  role                  MembershipRole   @default(TECHNICIAN)
  status                InvitationStatus @default(PENDING)
  tokenHash             String           @unique @map("token_hash") @db.VarChar(255)
  expiresAt             DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt            DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy Membership @relation("InvitationInviter", fields: [tenantId, invitedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, email])
  @@index([tenantId, expiresAt])
  @@index([tenantId, status])
  @@map("invitations")
}

// -----------------------------------------------------
// CUSTOMER
// Every customer belongs to exactly one tenant.
// -----------------------------------------------------

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(150)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(40)
  street    String   @db.VarChar(200)
  city      String   @db.VarChar(100)
  state     String?  @db.VarChar(100)
  zipCode   String?  @map("zip_code") @db.VarChar(30)
  country   String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs     Job[]
  invoices Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, email])
  @@map("customers")
}

// -----------------------------------------------------
// JOB
// Work assigned to a tenant's technician.
// -----------------------------------------------------

model Job {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  customerId      String      @map("customer_id") @db.Uuid
  assignedToId    String?     @map("assigned_to_id") @db.Uuid
  title           String      @db.VarChar(200)
  description     String      @db.Text
  completionNotes String?     @map("completion_notes") @db.Text
  status          JobStatus   @default(SCHEDULED)
  priority        JobPriority @default(NORMAL)
  scheduledAt     DateTime?   @map("scheduled_at") @db.Timestamptz(6)
  startedAt       DateTime?   @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  assignedTo Membership? @relation("JobAssignee", fields: [tenantId, assignedToId], references: [tenantId, id], onDelete: Restrict)

  photos  JobPhoto[]
  invoice Invoice?

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, assignedToId])
  @@map("jobs")
}

// -----------------------------------------------------
// JOB PHOTOS
// Actual files live in S3-compatible object storage.
// PostgreSQL stores metadata and storage keys only.
// -----------------------------------------------------

model JobPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  storageKey  String   @map("storage_key") @db.VarChar(500)
  fileName    String   @map("file_name") @db.VarChar(255)
  contentType String   @map("content_type") @db.VarChar(100)
  sizeBytes   BigInt   @map("size_bytes")
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  job Job @relation(fields: [tenantId, jobId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, jobId])
  @@map("job_photos")
}

// -----------------------------------------------------
// INVOICE
// Final monetary totals are stored in integer cents.
// -----------------------------------------------------

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  jobId         String        @map("job_id") @db.Uuid
  invoiceNumber String        @map("invoice_number") @db.VarChar(50)
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("USD") @db.VarChar(3)
  subtotalCents BigInt        @map("subtotal_cents")
  taxRateBps    Int           @map("tax_rate_bps")
  taxCents      BigInt        @map("tax_cents")
  totalCents    BigInt        @map("total_cents")
  issuedAt      DateTime?     @map("issued_at") @db.Timestamptz(6)
  dueAt         DateTime?     @map("due_at") @db.Timestamptz(6)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(6)
  voidedAt      DateTime?     @map("voided_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  job      Job      @relation(fields: [tenantId, jobId], references: [tenantId, id], onDelete: Restrict)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, jobId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("invoices")
}

// -----------------------------------------------------
// INVOICE LINE ITEMS
//
// MATERIAL:
// quantity and unitPriceCents are used.
//
// LABOR:
// laborMinutes and hourlyRateCents are used.
//
// OTHER:
// quantity and unitPriceCents are used.
//
// The application calculates exact amounts using
// integer arithmetic. It rounds once at invoice level.
// No independently rounded line-item amount is stored.
// -----------------------------------------------------

model InvoiceLineItem {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  invoiceId       String       @map("invoice_id") @db.Uuid
  type            LineItemType @default(OTHER)
  description     String       @db.VarChar(255)
  quantity        Int          @default(1)
  unitPriceCents  BigInt?      @map("unit_price_cents")
  laborMinutes    Int?         @map("labor_minutes")
  hourlyRateCents BigInt?      @map("hourly_rate_cents")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("invoice_line_items")
}

// -----------------------------------------------------
// PAYMENTS
// Stripe checkout and payment tracking.
// -----------------------------------------------------

model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  tenantId                String        @map("tenant_id") @db.Uuid
  invoiceId               String        @map("invoice_id") @db.Uuid
  amountCents             BigInt        @map("amount_cents")
  currency                String        @default("USD") @db.VarChar(3)
  status                  PaymentStatus @default(PENDING)
  stripeCheckoutSessionId String?       @unique @map("stripe_checkout_session_id") @db.VarChar(255)
  stripePaymentIntentId   String?       @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  paidAt                  DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
  @@map("payments")
}

// -----------------------------------------------------
// STRIPE EVENTS
// Global webhook inbox.
// Stripe event IDs are globally unique.
// Access must be restricted to trusted webhook workers.
// -----------------------------------------------------

model StripeEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique @map("event_id") @db.VarChar(255)
  eventType   String    @map("event_type") @db.VarChar(150)
  tenantId    String?   @map("tenant_id") @db.Uuid
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([processedAt])
  @@map("stripe_events")
}

// -----------------------------------------------------
// OUTBOX EVENTS
// Reliable background processing.
// Written in the same database transaction as
// the business operation that creates the event.
// -----------------------------------------------------

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  eventType   String       @map("event_type") @db.VarChar(150)
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(6)
  lastError   String?      @map("last_error") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, availableAt])
  @@map("outbox_events")
}